{
  "manifest_version": 3,
  "name": "Workspaces",
  "version": "0.1.0",
  "description": "Split your tabs into workspaces (work / personal ...). Built on tab groups: only the active workspace's tabs are expanded.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Workspaces",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "commands": {
    "next-workspace": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Switch to the next workspace"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
