{
  "manifest_version": 3,
  "name": "Fjord Dark Theme",
  "version": "0.1.0",
  "description": "Dark Nordic colours for the browser frame, tab strip, toolbar and address bar (matches the Fjord design tokens).",
  "theme": {
    "colors": {
      "frame": [15, 17, 21],
      "frame_inactive": [22, 24, 29],
      "frame_incognito": [32, 35, 42],
      "frame_incognito_inactive": [22, 24, 29],
      "toolbar": [32, 35, 42],
      "tab_text": [246, 247, 249],
      "tab_background_text": [154, 161, 173],
      "bookmark_text": [199, 204, 214],
      "ntp_background": [22, 24, 29],
      "ntp_text": [246, 247, 249],
      "ntp_link": [129, 140, 248],
      "button_background": [0, 0, 0, 0],
      "omnibox_background": [22, 24, 29],
      "omnibox_text": [246, 247, 249]
    },
    "properties": { "ntp_background_alignment": "center" }
  }
}
