{
  "manifest_version": 3,
  "name": "Fjord",
  "version": "0.2.0",
  "description": "Everything built into Fjord in one extension: side panel with pinned sites, speed dial new tab, workspaces and the ad blocker.",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "webNavigation",
    "alarms",
    "tabs",
    "search",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fjord",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "modules/sidebar/panel.html"
  },
  "options_ui": {
    "page": "modules/sidebar/options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "modules/newtab/newtab.html"
  },
  "commands": {
    "next-workspace": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Switch to the next workspace"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "baseline",
        "enabled": true,
        "path": "modules/adblock/rules/baseline.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "modules/adblock/rules/trackers.json"
      },
      {
        "id": "consent",
        "enabled": true,
        "path": "modules/adblock/rules/consent.json"
      },
      {
        "id": "strict",
        "enabled": true,
        "path": "modules/adblock/rules/strict.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "modules/adblock/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "modules/rail/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/tokens.css",
        "ui/base.css",
        "ui/icons.js",
        "ui/glyph.js",
        "modules/rail/rail.js",
        "modules/rail/rail.css",
        "modules/sidebar/store.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
